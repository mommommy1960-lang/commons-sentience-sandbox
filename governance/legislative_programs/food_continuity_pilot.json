    "complaint resolution time",
    "displacement of existing services",
    "privacy incidents"
  ],
  "stop_conditions": [
    "serious repeated safety failure without timely correction",
    "unremediated privacy misuse",
    "systematic discrimination or denial of appeal",
    "unfunded burden materially destabilizes recovery partners",
    "required evaluation cannot be completed credibly"
  ],
  "sunset": {
    "required": true,
    "operational_years": 3,
    "affirmative_legislative_renewal": true,
    "public_hearing": true,
    "harm_response_required": true
  }
